# Sarfkor backend — required configuration.
#
# ASP.NET Core's environment-variable provider maps `__` to the `:` used in appsettings.json/
# User Secrets — e.g. ConnectionStrings__DefaultConnection == "ConnectionStrings:DefaultConnection".
# This file documents names only (no real values, no secrets) — see Backend/src/WebApi/Program.cs
# for what reads each one, and .github/workflows/backend-ci.yml for the CI-only placeholder values.
#
# Local dev: `dotnet user-secrets set "Key:SubKey" "value"` from Backend/src/WebApi instead of a
# real .env file — this project doesn't load .env files, this is documentation only.

# Postgres connection string. App fails at DbContext use if unset/unreachable.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=sarfkor;Username=postgres;Password=

# JWT signing — app refuses to start with a clear error if any of these three are missing.
Jwt__Issuer=
Jwt__Audience=
Jwt__Key=

# Bootstraps the one Admin account on first run (moderation panel access) — if either is unset,
# the app logs a warning and skips seeding instead of failing to start (there's no admin surface
# otherwise reachable, but nothing else in the app depends on it).
Admin__Email=
Admin__Password=

# Origins allowed to call the API from a browser (indexed: __0, __1, __2, ... for multiple).
Cors__AllowedOrigins__0=http://localhost:5173

# Gmail SMTP for the "Забыли пароль" reset email. If Username/Password are unset, ForgotPassword
# requests still succeed generically (no email enumeration leak) but no email is sent — the
# failure is logged with a clear message, not a raw MailKit exception.
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__FromName=Sarfkor

# Base URL of the deployed frontend — used to build the password-reset link. Defaults to
# http://localhost:5173 in code if unset, which is wrong in any deployed environment.
Frontend__BaseUrl=http://localhost:5173
